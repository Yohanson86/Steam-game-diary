<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="steam_game_diary.db" />
        <include domain="database" path="steam_game_diary.db-wal" />
        <include domain="database" path="steam_game_diary.db-shm" />
